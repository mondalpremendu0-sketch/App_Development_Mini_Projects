{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/app/(auth)/signIn.jsx",
    "src/contexts/auth-context.jsx",
    "src/app/(auth)/signUp.jsx"
  ]
}
